# Serves the compiled app on Railway (see Dockerfile.railway).
#
# Railway terminates TLS and tells the service which port to listen on through PORT, so this
# listens on plain HTTP there and asks Caddy for no certificate.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# The router lives in the browser, so /dashboard is not a file. Serve the file if there is one,
	# and the app's entry page otherwise, and let the router take over.
	try_files {path} /index.html
	file_server

	# Everything but the built assets is revalidated on every load. The entry page is the one
	# that matters: after a deploy it has to point at the new files, and a copy kept from before
	# would ask for files that are gone.
	@shell not path /assets/* /fonts/*
	header @shell Cache-Control "no-cache"

	# The same headers, with the same HSTS_MAX_AGE, as the backend's proxy. HSTS starts low on
	# purpose: a browser that has seen it refuses plain HTTP for the whole window, so a broken
	# certificate in the first rollout would lock people out for as long as it says.
	#
	# No Referrer-Policy here: the map loads its tiles from another host, and the browser's
	# default is what a tile server expects.
	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:300}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}
