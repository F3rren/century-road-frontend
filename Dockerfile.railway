# The frontend as it runs on Railway: the compiled app, served by Caddy.
#
# Kept apart from Dockerfile on purpose. That one is for Compose: its nginx proxies /api/ to a
# host called "backend", which does not exist on Railway, and nginx will not start without it.
# Here the browser calls the gateway directly, at the address given when the image is built.
#
# Not built by Railway. CI builds and pushes this image on every push to main/develop (see
# .github/workflows/ci.yml's publish-image job and README.md's "Container images" section), and
# the Railway service is set to *Add -> Docker Image*, pointed at a released tag - see
# README.md's "Running it on Railway". VITE_API_BASE_URL is supplied to the CI build as a
# repository variable, not by Railway: baked into the compiled files, so changing it means a new
# image. Left empty, the app falls back on /api on its own origin (see src/services/api.ts).
#
# The gateway must allow this app's origin: FRONTEND_ORIGIN there is this service's public
# address, exactly, with no trailing slash.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile.railway /etc/caddy/Caddyfile
